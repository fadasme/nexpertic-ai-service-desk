# Nexpertic AI Service Desk
# Safe template only. Do not commit real secrets or customer tokens.

# Local demo mode keeps the product usable without SSO while developing.
# For pilot/customer environments switch to:
# NEXERA_AUTH_MODE=production
# NEXERA_SEED_DEMO=false
NEXERA_AUTH_MODE=demo
NEXERA_SEED_DEMO=true
NEXERA_ALLOW_DEMO_CLEANUP=false
NEXERA_E2E_VALIDATED=false
NEXERA_E2E_VALIDATED_AT=

# Generate unique values per environment. Minimum recommendation: 32+ random bytes.
NEXERA_SESSION_SECRET=replace-with-long-random-session-secret
NEXERA_CONSENT_SECRET=replace-with-long-random-consent-secret
NEXERA_OIDC_STATE_SECRET=replace-with-long-random-oidc-state-secret
NEXERA_SESSION_TTL_MINUTES=120

# Acceso interno opcional para administracion local.
NEXERA_LOCAL_ADMIN_EMAIL=admin@nexera.local
NEXERA_LOCAL_ADMIN_PASSWORD=Admin123!

# OIDC / Microsoft Entra ID
OIDC_PROVIDER=oidc
OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
OIDC_CLIENT_ID=<client-id>
OIDC_CLIENT_SECRET=<client-secret>
OIDC_REDIRECT_URI=https://<domain>/api/auth/oidc/callback
# For local testing you can temporarily use:
# OIDC_REDIRECT_URI=http://localhost:3000/api/auth/oidc/callback
OIDC_SCOPES=openid profile email
OIDC_JWKS_URI=
OIDC_JWKS_CACHE_TTL_SECONDS=600
OIDC_GROUPS_ADMIN=Nexpertic-Admins
OIDC_GROUPS_ANALYST=Nexpertic-Analysts
OIDC_GROUPS_EXECUTIVE=Nexpertic-Executives
OIDC_GROUPS_USER=Nexpertic-Users

# GLPI integration
GLPI_BASE_URL=https://glpi.example.com
GLPI_APP_TOKEN=<glpi-app-token>
GLPI_USER_TOKEN=<glpi-user-token>
GLPI_TIMEOUT_MS=8000
GLPI_MAX_RETRIES=1

# Optional D1 CLI target for operational scripts.
NEXERA_D1_DATABASE=<cloudflare-d1-database-name-or-id>
