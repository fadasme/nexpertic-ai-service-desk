# Nexpertic AI Service Desk - pilot/customer environment template
# Safe placeholders only. Do not commit real secrets or customer tokens.
# Copy values into a local ignored .env file or your deployment secret store.

# Pilot mode must not allow demo auth or demo seed data.
NEXERA_AUTH_MODE=production
NEXERA_SEED_DEMO=false
NEXERA_ALLOW_DEMO_CLEANUP=false

# Fill after a formal local/customer E2E run.
NEXERA_E2E_VALIDATED=false
NEXERA_E2E_VALIDATED_AT=

# Generate unique 48-byte+ values per environment.
# Example:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
NEXERA_SESSION_SECRET=<generate-48-byte-base64url-secret>
NEXERA_CONSENT_SECRET=<generate-48-byte-base64url-secret>
NEXERA_OIDC_STATE_SECRET=<generate-48-byte-base64url-secret>

# OIDC / Microsoft Entra ID
OIDC_PROVIDER=oidc
OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
OIDC_CLIENT_ID=<client-id>
OIDC_CLIENT_SECRET=<client-secret>
OIDC_REDIRECT_URI=https://<pilot-domain>/api/auth/oidc/callback
OIDC_SCOPES=openid profile email
OIDC_JWKS_URI=
OIDC_JWKS_CACHE_TTL_SECONDS=600
OIDC_GROUPS_ADMIN=Nexpertic-Admins
OIDC_GROUPS_ANALYST=Nexpertic-Analysts
OIDC_GROUPS_EXECUTIVE=Nexpertic-Executives
OIDC_GROUPS_USER=Nexpertic-Users

# GLPI integration
GLPI_BASE_URL=https://glpi.example.com
GLPI_APP_TOKEN=<glpi-app-token>
GLPI_USER_TOKEN=<glpi-user-token>
GLPI_TIMEOUT_MS=8000
GLPI_MAX_RETRIES=1

# Cloudflare D1 target for operational scripts.
NEXERA_D1_DATABASE=<cloudflare-d1-database-name-or-id>

# Acceso local opcional; desactivado sin contraseña explícita.
NEXERA_LOCAL_ADMIN_EMAIL=admin@nexera.local
NEXERA_LOCAL_ADMIN_PASSWORD=
